[Unit]
Description=SearXNG (méta-moteur local pour le preset Web de pilote)
After=network.target

[Service]
Type=simple
Environment=SEARXNG_SETTINGS_PATH=%CIBLE%/settings.yml
WorkingDirectory=%CIBLE%/src
ExecStart=%CIBLE%/venv/bin/python -m searx.webapp
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
